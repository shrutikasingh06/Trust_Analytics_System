# Copy to .env and fill only credentials you are authorized to use.
# Empty = provider NOT configured. Do not invent live results.
# .env is gitignored. Never commit real keys.

# --- Amazon (recommended live path: Rainforest) ---
# Same value may be set as either name:
RAINFOREST_API_KEY=
AMAZON_PROVIDER_API_KEY=

# Optional Amazon fallback (paid; also returns reviews)
SERPAPI_API_KEY=

# Amazon Product Advertising API — product metadata only, NOT customer review text
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=

# --- Flipkart ---
# Official Affiliate Product API: title, price, currency, brand. No customer review text.
# Apply: https://affiliate.flipkart.com/
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_PROVIDER_API_KEY=

# --- Placeholders: no authorized backend is wired yet ---
MYNTRA_PROVIDER_API_KEY=
NYKAA_PROVIDER_API_KEY=
MEESHO_PROVIDER_API_KEY=
AJIO_PROVIDER_API_KEY=
CROMA_PROVIDER_API_KEY=
RELIANCE_DIGITAL_PROVIDER_API_KEY=
TATA_CLIQ_PROVIDER_API_KEY=

# Optional JSON-LD Product parse (single GET, no CAPTCHA bypass). Default false.
GENERIC_JSONLD_ENABLED=false

HTTP_TIMEOUT_SEC=20
MAX_REVIEWS=50
